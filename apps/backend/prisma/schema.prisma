// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

enum RoleName {
  Admin
  Librarian
  Member
  PotentialMember
}

enum ApplicationStatus {
  pending_approval
  approved
  rejected
}

model AppConfig {
  config_id Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  notes     String?  @db.Text
  updated_at DateTime @default(now()) @updatedAt
}

model RegistrationSettings {
  id                Int      @id @default(autoincrement())
  registration_password String @db.VarChar(255)
  updated_at        DateTime @default(now()) @updatedAt
  updated_by_id     Int?
}

model Roles {
  role_id   Int      @id @default(autoincrement())
  role_name RoleName @unique
  users     Users[]
}

model Users {
  user_id                                 Int                @id @default(autoincrement())
  username                                String             @unique @db.VarChar(100)
  password_hash                           String             @db.VarChar(255)
  name                                    String             @db.VarChar(100)
  email                                   String             @unique @db.VarChar(255)
  phone_number                            String             @db.VarChar(20)
  role_id                                 Int
  application_status                      ApplicationStatus  @default(pending_approval)
  requested_librarian_role_on_application Boolean            @default(false)
  created_at                              DateTime           @default(now())
  updated_at                              DateTime           @updatedAt
  role                                    Roles              @relation(fields: [role_id], references: [role_id])
  posts                                   Posts[] // Relation to Posts table
  materials_uploaded                      Materials[]        @relation("UploadedBy") // Relation to Materials table (uploader)
  schedules_created                       Schedules[] // Relation to Schedules table (creator)
  sudabang_messages_sent                  SudabangMessages[] // Relation to SudabangMessages table
  comments                                Comments[] // Relation to Comments table
  read_books                              ReadBooks[] // Relation to ReadBooks table (adder)
  refresh_tokens                          RefreshTokens[] // Relation to RefreshTokens table
  audit_logs                              AuditLogs[] // Relation to AuditLogs table (audit event creator)

  @@index([email])
  @@index([username])
}

model BoardTypes {
  board_type_id Int     @id @default(autoincrement())
  name          String  @unique @db.VarChar(100)
  description   String? @db.Text
  posts         Posts[] // Relation to Posts table
}

model Posts {
  post_id       Int        @id @default(autoincrement())
  board_type_id Int
  user_id       Int
  title         String     @db.VarChar(255)
  content       String     @db.Text
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  board_type    BoardTypes @relation(fields: [board_type_id], references: [board_type_id])
  author        Users      @relation(fields: [user_id], references: [user_id])
  comments      Comments[] // Relation to Comments table
  is_notice     Boolean    @default(false)
  view_count    Int        @default(0)

  @@index([board_type_id])
  @@index([user_id])
}

model MaterialTypes {
  material_type_id Int         @id @default(autoincrement())
  name             String      @unique @db.VarChar(100)
  description      String?     @db.Text
  materials        Materials[] // Relation to Materials table
}

model Materials {
  material_id        Int           @id @default(autoincrement())
  material_type_id   Int
  uploaded_by_id     Int           // Changed to match seed.ts
  title              String        @db.VarChar(255)
  description        String?       @db.Text
  file_url           String        @db.VarChar(500)
  file_size_kb       Int? // 파일 크기 (KB)
  original_file_name String?       @db.VarChar(255)
  uploaded_at        DateTime      @default(now())
  material_type      MaterialTypes @relation(fields: [material_type_id], references: [material_type_id])
  uploaded_by        Users         @relation("UploadedBy", fields: [uploaded_by_id], references: [user_id])

  @@index([material_type_id])
  @@index([uploaded_by_id])
}

model Schedules {
  schedule_id    Int       @id @default(autoincrement())
  created_by_id  Int       // Changed to match seed.ts
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  start_time     DateTime // Kept for potential legacy or specific use
  end_time       DateTime? // Kept for potential legacy or specific use
  start_datetime DateTime // Preferred field for start
  end_datetime   DateTime? // Preferred field for end
  location       String?   @db.VarChar(255)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt
  created_by     Users     @relation(fields: [created_by_id], references: [user_id])

  @@index([created_by_id])
}

model SudabangMessages {
  message_id Int        @id @default(autoincrement())
  user_id    Int
  content    String     @db.Text
  created_at DateTime   @default(now())
  updated_at DateTime   @default(now()) @updatedAt
  author     Users      @relation(fields: [user_id], references: [user_id])
  comments   Comments[] // Relation to Comments table

  @@index([user_id])
}

model Comments {
  comment_id                 Int               @id @default(autoincrement())
  user_id                    Int
  parent_post_id             Int?
  parent_sudabang_message_id Int?
  content                    String            @db.Text
  created_at                 DateTime          @default(now())
  updated_at                 DateTime          @default(now()) @updatedAt
  author                     Users             @relation(fields: [user_id], references: [user_id])
  parent_post                Posts?            @relation(fields: [parent_post_id], references: [post_id])
  parent_sudabang_message    SudabangMessages? @relation(fields: [parent_sudabang_message_id], references: [message_id])

  @@index([user_id])
  @@index([parent_post_id])
  @@index([parent_sudabang_message_id])
  // Application-level check: parent_post_id OR parent_sudabang_message_id must be NOT NULL.
}

model ReadBooks {
  read_book_id     Int       @id @default(autoincrement())
  title            String    @db.VarChar(255)
  author           String?   @db.VarChar(255)
  cover_image_url  String?   @db.VarChar(1024)
  description      String?   @db.Text
  date_read        DateTime? @db.Date // Prisma uses DateTime for Date SQL type
  added_by_user_id Int
  added_at         DateTime  @default(now())
  added_by         Users     @relation(fields: [added_by_user_id], references: [user_id])

  @@index([added_by_user_id])
}

model IntroductionContent {
  content_id    Int      @id @default(autoincrement())
  section_key   String   @unique @db.VarChar(100)
  content_value String   @db.Text
  updated_at    DateTime @default(now()) @updatedAt
}

model RefreshTokens {
  token_id   Int      @id @default(autoincrement())
  user_id    Int
  token_hash String   @unique @db.VarChar(255)
  expires_at DateTime
  created_at DateTime @default(now())
  is_revoked Boolean  @default(false)
  user       Users    @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@index([token_hash])
}

model AuditLogs {
  audit_id   Int      @id @default(autoincrement())
  event_type String   @db.VarChar(100)
  user_id    Int
  target_id  Int?
  details    String?  @db.Text
  created_at DateTime @default(now())
  user       Users    @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@index([event_type])
  @@index([created_at])
}
